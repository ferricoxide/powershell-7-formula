# -*- coding: utf-8 -*-
# vim: ft=yaml
---
# ==============================================================================
# PowerShell 7 Formula Pillar Configuration Example
# ==============================================================================
# This file maps the parameters available to customize the target engine
# environment lookup configurations on destination minions.
# ==============================================================================

powershell-7:
  lookup:

    # ==========================================================================
    # A. CORE ENVIRONMENT POLICY DIRECTIVES (config)
    # ==========================================================================
    config:

      # --- Linux-Specific Parameters ------------------------------------------
      # Explicit vendor repository registration controls for RedHat families.
      repo_rpm_name: 'packages-microsoft-prod'
      repo_rpm_uri: 'https://packages.microsoft.com/config/rhel/9/packages-microsoft-prod.rpm'

      # --- Windows-Specific Parameters ----------------------------------------
      # Context-Aware Hardening Enforcement: Controls standalone security policy
      # injection. Set to false to avoid baseline policy drift or concurrent
      # execution friction with active 'ash-windows' highstate frameworks.
      enforce_hardening: true

      # Shared Organizational Profile Theme Customizations: Modifies console
      # colors and startup tracking indicators inside the managed profile script.
      theme:
        bg_color: 'DarkBlue'
        fg_color: 'White'
        greeting: 'Welcome to the Secure Enterprise Console Environment.'
        prefix: '[SECURE-NODE]'


    # ==========================================================================
    # B. CORE PACKAGING & PACKAGE-MANAGER DIRECTIVES (pkg)
    # ==========================================================================
    pkg:

      # --- Dual-Platform Parameters (Shared Keys, Divergent Expectations) ----
      #
      # 1. 'name': System Package Registry Identifier
      #    - Linux: Matches standard yum/dnf package name mapping ('powershell').
      #    - Windows: Matches the Appx/MSI display registry key ('PowerShell').
      name: 'PowerShell'

      # 2. 'install_root': Core System Target Execution Path ($PSHOME)
      #    - Linux Default: '/opt/microsoft/powershell/7'
      #    - Windows Default: 'C:/Program Files/PowerShell/7'
      install_root: 'C:/Program Files/PowerShell/7'

      # 3. 'download_uri': Target Remote Asset Retrieval Path
      #    - Shared Behavior: Leave empty to leverage native repos (Linux dnf/
      #      yum). Provide a direct path to implement detached source extraction.
      #    - Linux Formats: Target local/remote '.rpm' or '.tar.gz' archives.
      #    - Windows Formats: Target remote '.msi' or manual '.zip' files.
      download_uri: 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.3/PowerShell-7.6.3-win-x64.msi'

      # 4. 'download_sig': Cryptographic Integrity Hash
      #    - Shared Behavior: Mandatory for validating archive signature checks
      #      when performing manual '.tar.gz' or '.zip' decoupled extractions.
      download_sig: 'sha256=a8a05aa19fb681468d6d884202336eae0af17b882731d173cf89a30a3d9b7c40'


      # --- Windows-Specific Winrepo Parameters --------------------------------
      # These elements are exclusively required when orchestrating local Windows
      # Software Repository (winrepo) MSI definitions to support clean local
      # database compilation loops.
      #
      # 'version': The strict 3-part or 4-part destination software contract
      # version. Requisite condition when 'download_uri' points to an MSI path.
      version: '7.6.3'

      # 'full_name': Explicitly overrides the winrepo database DisplayName match
      # sequence string to align with custom enterprise corporate gold masters.
      full_name: 'PowerShell 7-x64'
